PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/techverse
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
STORAGE_PORT=5001
STORAGE_SERVER_URL=http://localhost:5001
AUTO_START_STORAGE_SERVER=true
# Coding Arena tuning (optional)
# CODE_RUN_MAX_CONCURRENCY=24    # max simultaneous compiles/runs (default: 2x CPU cores)
# CODE_RUN_MAX_QUEUE_WAIT_MS=8000 # how long a run may sit in the queue before 503

